# Copy to `.env` and fill in to enable the "Connect Google Calendar" button
# without pasting the client id in the UI each device.
#
# Create the client id in Google Cloud Console:
#   APIs & Services -> Credentials -> OAuth client ID -> Web application
# Add your run origin (e.g. http://localhost:5173) to Authorized JavaScript
# origins. This value is NOT a secret and is safe to ship in a frontend build.
# See README -> "Connect Google Calendar" for the full walkthrough.
VITE_GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
